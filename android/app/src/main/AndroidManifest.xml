<?xml version="1.0" encoding="utf-8"?>
<!-- Tout le site est dans l'application : les jeux marchent sans connexion. Internet ne sert qu'aux comptes
     (facultatifs), pour parler au serveur des comptes (Supabase) ; rien d'autre ne sort du téléphone.
     La dictée de « À l'aveugle » passe par le service de reconnaissance vocale du téléphone.
     Les liens vers d'autres sites, et la connexion avec Google, Meta ou LinkedIn, s'ouvrent dans le navigateur. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Internet : seulement pour les comptes (serveur Supabase) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- le micro, seulement pour la dictée des coups dans « À l'aveugle » (demandé la première fois qu'on s'en sert) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- la voix du téléphone (TextToSpeech) : Android 11+ demande de déclarer ce qu'on cherche -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/nom"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.Echecs">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode|locale|layoutDirection|fontScale"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- le retour d'une connexion faite dans le navigateur (Google, Meta, LinkedIn, lien de l'e-mail) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="pomchess" android:host="connexion" />
            </intent-filter>
        </activity>
    </application>
</manifest>
